<sd:ModalWindow x:Class="Stride.Core.Assets.Editor.Components.FixAssetReferences.Views.FixAssetReferencesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                  xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:view="clr-namespace:Stride.Core.Assets.Editor.View"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:valueConverters="clr-namespace:Stride.Core.Assets.Editor.View.ValueConverters"
                  xmlns:far="clr-namespace:Stride.Core.Assets.Editor.Components.FixAssetReferences"
                  mc:Ignorable="d"
                  ShowInTaskbar="False"
                  Title="{Binding FixedObjectsCounter, StringFormat=Fix references ({0})}"
                  Height="768" Width="1024" Style="{DynamicResource WindowChromeStyle}"
                  d:DataContext="{d:DesignInstance far:FixAssetReferencesViewModel}">
  <sd:ModalWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../View/CommonResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </sd:ModalWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <Image Margin="10" DockPanel.Dock="Left" Source="{Binding CurrentObjectToReplace.ThumbnailData.Presenter, Mode=OneWay}" Width="64" Height="64"/>
      <TextBlock Margin="10,20" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding CurrentObjectToReplace.Url, StringFormat=The asset {0} is referenced by other assets. Choose how to handle these references.}"/>
    </DockPanel>
    <RadioButton Grid.Row="1" Margin="20" IsChecked="{Binding UseSingleReplace}" Content="Replace all the references with a reference to a different asset:"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" IsEnabled="{Binding UseSingleReplace}">
      <sd:TextBox Text="{Binding SingleReplacementObject, Converter={valueConverters:AssetViewModelToUrl}}" Margin="30,0,4,0" MinWidth="200" WatermarkContent="Select an asset"/>
      <UniformGrid Rows="1">
        <Button Command="{Binding PickupSingleReplacementObjectCommand}"  Background="Transparent" ToolTip="Select asset">
          <Image Source="{StaticResource ImagePickup}" RenderOptions.BitmapScalingMode="NearestNeighbor" Width="16" Height="16"/>
        </Button>
      </UniformGrid>
    </StackPanel>
    <view:DataGridEx Margin="20" Grid.Row="4" ItemsSource="{Binding CurrentReplacements}" IsEnabled="{Binding UseSingleReplace, Converter={sd:InvertBool}}" AutoGenerateColumns="False" CanUserResizeRows="False"  CanUserReorderColumns="False" RowHeaderWidth="0" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Referencer" Width="2*"  >
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}}" d:DataContext="{d:DesignInstance far:AssetReferenceReplacementViewModel}" Text="{Binding Referencer.Url}"></TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Replacement asset" Width="3*"  >
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}}" d:DataContext="{d:DesignInstance far:AssetReferenceReplacementViewModel}">
                <Button Command="{Binding PickupReplacementObjectCommand}"
                    ToolTip="Select asset" DockPanel.Dock="Right" Content="{sd:Image {StaticResource ImagePickup}, 16, 16, NearestNeighbor}"
                    Background="Transparent" IsEnabled="{Binding IsChecked, ElementName=ClearCheckBox, Converter={sd:InvertBool}}"/>
                <CheckBox x:Name="ClearCheckBox" Content="Clear this reference" Margin="10,0" DockPanel.Dock="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                      IsChecked="{Binding DontFixReference}"/>
                <sd:TextBox Text="{Binding ReplacementObject, Converter={valueConverters:AssetViewModelToUrl}}"
                          Margin="10,0" MinWidth="200" WatermarkContent="Select an asset" IsEnabled="{Binding IsChecked, ElementName=ClearCheckBox, Converter={sd:InvertBool}}"/>
              </DockPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </view:DataGridEx>
    <RadioButton Grid.Row="3" Margin="20" Content="Replace references individually:" IsChecked="{Binding UseSingleReplace, Converter={sd:InvertBool}}"/>
    <UniformGrid Grid.Row="5" Rows="1" DockPanel.Dock="Bottom" Margin="20">
      <Button Margin="10,0,0,0" Padding="10,4" Content="Done" Command="{Binding FixReferencesCommand}"/>
      <Button Margin="10,0,0,0" Padding="10,4" Content="Clear references" Command="{Binding ClearReferencesCommand}" ToolTip="Clear the references of the current asset"/>
      <Button Margin="10,0,0,0" Padding="10,4" Content="Clear all references" Command="{Binding ClearAllReferencesCommand}" ToolTip="Clear references for all assets being deleted"/>
      <Button Margin="10,0,0,0" Padding="10,4" Content="Cancel" IsCancel="True" ToolTip="Cancel operation">
        <i:Interaction.Behaviors>
          <sd:ButtonCloseWindowBehavior DialogResult="Cancel"/>
        </i:Interaction.Behaviors>
      </Button>
    </UniformGrid>
  </Grid>
</sd:ModalWindow>
