<!--
***********************************************************************************************
  Stride.Build.Sdk: Stride.Frameworks.props

  Define per-platform default TFMs
  EVALUATION PHASE: Early (BEFORE project file)

  Copyright (C) Stride and its contributors
***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Define default frameworks for each target -->
  <PropertyGroup>
    <StrideFramework>net10.0</StrideFramework>

    <StrideFrameworkWindows>net10.0-windows</StrideFrameworkWindows>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- StrideTargetFramework collapses any platform-version suffix on TargetFramework down to
       the family constant: net10.0-windows10.0.19041.0 → net10.0-windows.

       SDK conditions compare against this so a project can opt into a versioned OS moniker
       (e.g. for version-specific projection access) without breaking platform/dependency setup. -->
  <PropertyGroup>
    <StrideTargetFramework>$(TargetFramework)</StrideTargetFramework>
    <StrideTargetFramework Condition="$(TargetFramework.StartsWith('$(StrideFrameworkWindows)'))">$(StrideFrameworkWindows)</StrideTargetFramework>
  </PropertyGroup>

</Project>
