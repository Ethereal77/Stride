<!--
***********************************************************************************************
  Stride.MultiGraphicsApiHost.targets

  Local multi-API bin layout (when StrideMultiGraphicsApiHost = true).
  EVALUATION PHASE: Late (AFTER project file)

  Copyright (C) Stride and its contributors
***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    For hosts that pick the graphics API at launch (GameStudio, AssetCompiler),
    lay API-dependent runtime assemblies into per-API subdirs (bin/.../Direct3D12/Stride.Graphics.dll)
    instead of flat. GraphicsApiHostResolver loads the selected one.

    Routed in:
      (1) Stride.* graphics assemblies (same identity across APIs, so must be isolated;
          detected by their "bin/<cfg>[/<tfm>]/<Api>/" path),
          with the natives their .ssdeps lists outside runtimes/ (Direct3D12/D3D12/D3D12Core.dll) and

      (2) API-exclusive interop (Silk.NET.Direct3D12/WinPixEventRuntime -> "Direct3D12/",
          Vortice.Vulkan -> "Vulkan/").
          Shared interop stays flat (DXGI/DXC span D3D11+D3D12; Silk.NET.Direct3D11 is used
          cross-API by FXC reflection).
  -->

  <PropertyGroup>
    <!--
      APIs laid out = the APIs this build produces.

      $(StrideGraphicsApis) is final here: platform default, single-API override
      (e.g. per-API CI jobs), or the full set on package builds (StrideGraphicsApiDependentBuildAll).
      The launch-time choice is limited to this set; a variant that wasn't built can't be staged.
    -->
    <StrideMultiGraphicsApiHostApis Condition="'$(StrideMultiGraphicsApiHostApis)' == ''">$(StrideGraphicsApis)</StrideMultiGraphicsApiHostApis>
  </PropertyGroup>

  <!--
    Inline task: Classify copy-local items and compute their per-API siblings.
  -->
  <UsingTask TaskName="_StrideComputeMultiApiLayout"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <CopyLocalItems ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />

      <Apis ParameterType="System.String" Required="true" />

      <!-- API-exclusive interop packages, as "PackageId=Api;PackageId=Api" (single API each) -->
      <ExclusiveApiPackages ParameterType="System.String" Required="false" />

      <!-- Graphics-API-dependent copy-local items to strip from the flat output -->
      <FlatToRemove ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />

      <!-- Per-API files to stage; metadata StageSubPath = "<Api>\<filename>". -->
      <Staged ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>

    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var apis = Apis.Split([';'], System.StringSplitOptions.RemoveEmptyEntries);
        
        var knownApis = new System.Collections.Generic.HashSet<string>(
            ["Direct3D11", "Direct3D12", "Vulkan", "Null"],
            System.StringComparer.OrdinalIgnoreCase);
        
        // PackageId -> single owning API (Silk.NET.Direct3D12=Direct3D12, Vortice.Vulkan=Vulkan, etc)
        var exclusive = new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.OrdinalIgnoreCase);
        
        var pkgToApiPairs = (ExclusiveApiPackages ?? "").Split([';'], System.StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in pkgToApiPairs)
        {
            var kv = pair.Split('=');
            if (kv.Length == 2)
                exclusive[kv[0].Trim()] = kv[1].Trim();
        }
        
        var flat = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        var staged = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        var seen = new System.Collections.Generic.HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
        
        foreach (var item in CopyLocalItems)
        {
            var path = item.GetMetadata("FullPath");
            var fileName = System.IO.Path.GetFileName(path);
            var dir = System.IO.Path.GetDirectoryName(path);
        
            // (1) Stride.* graphics Assembly:
            //   Same identity across APIs, produced under "bin/<cfg>[/<tfm>]/<Api>/<file>".
            //   Isolate all its sibling variants into subdirectories.
            if (dir is not null && knownApis.Contains(System.IO.Path.GetFileName(dir)))
            {
                flat.Add(item);
        
                // Strip the <Api> segment
                var apiRoot = System.IO.Path.GetDirectoryName(dir);
                foreach (var api in apis)
                {
                    var graphicsApiFile = System.IO.Path.Combine(apiRoot, api, fileName);
                    StageFileWithGraphicsApi(graphicsApiFile, api);
                    StageGraphicsApiNatives(graphicsApiFile, api);
                }
        
                continue;
            }
        
            // (2) API-exclusive interop / native package:
            //   Route this single file into its one API directory.
            //   Match by NuGet package id (package-origin copy-local) or, as a fallback,
            //   by file name (package id == assembly name for these interop packages).
            var pkgId = item.GetMetadata("NuGetPackageId");
            var nameNoExt = System.IO.Path.GetFileNameWithoutExtension(fileName);
        
            // Try to check if specific to an owning API
            var apiSpecificPkg = !string.IsNullOrEmpty(pkgId) && exclusive.TryGetValue(pkgId, out string owningApi);
            var apiSpecificName = exclusive.TryGetValue(nameNoExt, out owningApi);
        
            if (apiSpecificPkg || apiSpecificName)
            {
                flat.Add(item);
                StageFileWithGraphicsApi(path, owningApi);
            }
        }
        
        FlatToRemove = flat.ToArray();
        Staged = staged.ToArray();
        
        //
        // Stages a file (and its associated artifacts) with a specific Graphics API.
        //
        void StageFileWithGraphicsApi(string srcFile, string graphicsApi)
        {
            string[] filesToStage =
            [
                srcFile,
                System.IO.Path.ChangeExtension(srcFile, ".pdb"),
                System.IO.Path.ChangeExtension(srcFile, ".xml")
            ];
        
            foreach (var file in filesToStage)
            {
                if (!System.IO.File.Exists(file) ||
                    !seen.Add(graphicsApi + "|" + System.IO.Path.GetFileName(file)))
                    continue;
        
                var taskItem = new Microsoft.Build.Utilities.TaskItem(file);
                taskItem.SetMetadata("StageSubPath", System.IO.Path.Combine(graphicsApi, System.IO.Path.GetFileName(file)));
        
                staged.Add(taskItem);
            }
        }
        
        //
        // Stages the native files of an API variant outside "runtimes/<rid>/native/"
        // (e.g., Direct3D12/D3D12/D3D12Core.dll), listed in its .ssdeps.
        // They are looked up next to the variant's Assembly.
        // runtimes/ natives are shared and deployed flat.
        //
        void StageGraphicsApiNatives(string assemblyFile, string graphicsApi)
        {
            var ssdeps = System.IO.Path.ChangeExtension(assemblyFile, ".ssdeps");
            if (!System.IO.File.Exists(ssdeps))
                return;
        
            var variantDir = System.IO.Path.GetDirectoryName(assemblyFile);
        
            foreach (var line in System.IO.File.ReadAllLines(ssdeps))
            {
                var parts = line.Split(';');
                if (parts.Length < 2 || parts[0] != "NativeLib")
                    continue;
        
                var relativePath = parts[1].TrimStart('.', '/', '\\');
        
                var source = System.IO.Path.Combine(variantDir, relativePath);
                if (relativePath.StartsWith("runtimes/") ||
                    !System.IO.File.Exists(source) ||
                    !seen.Add(graphicsApi + "|" + relativePath))
                    continue;
        
                var destPath = System.IO.Path.Combine(graphicsApi, relativePath.Replace('/', System.IO.Path.DirectorySeparatorChar));
        
                var taskItem = new Microsoft.Build.Utilities.TaskItem(source);
                taskItem.SetMetadata("StageSubPath", destPath);
        
                staged.Add(taskItem);
            }
        };
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Strip the graphics DLLs from the flat copy-local set BEFORE they're copied to the output,
    and remember the per-API files to stage.
    Runs after references are resolved.
  -->
  <Target Name="_StrideMultiApiStripFlat"
          AfterTargets="ResolveReferences"
          BeforeTargets="GetCopyToOutputDirectoryItems;_CopyFilesMarkedCopyLocal"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(StrideMultiGraphicsApiHostApis)' != ''">

    <!--
      API-exclusive interop packages:
        Those whose GraphicsApis metadata names a single API.
        (Shared ones like Silk.NET.DXGI / DXC list multiple APIs and stay flat).
    -->
    <ItemGroup>
      <_StrideExclusiveApiPackage
          Include="@(StrideGraphicsApiSpecificPackage)"
          Condition="!$([System.String]::Copy('%(StrideGraphicsApiSpecificPackage.GraphicsApis)').Contains(';'))" />
    </ItemGroup>

    <PropertyGroup>
      <_StrideExclusiveApiPackagesStr>@(_StrideExclusiveApiPackage->'%(Identity)=%(GraphicsApis)', ';')</_StrideExclusiveApiPackagesStr>
    </PropertyGroup>

    <_StrideComputeMultiApiLayout
        CopyLocalItems="@(ReferenceCopyLocalPaths)"
        Apis="$(StrideMultiGraphicsApiHostApis)"
        ExclusiveApiPackages="$(_StrideExclusiveApiPackagesStr)">

      <Output TaskParameter="FlatToRemove" ItemName="_StrideMultiApiFlat" />
      <Output TaskParameter="Staged" ItemName="_StrideMultiApiStaged" />
    </_StrideComputeMultiApiLayout>

    <ItemGroup>
      <!--
        Absent from the app base so the default-context probe misses and
        the runtime resolver supplies the selected API's copy
        (no same-identity clash with a flat DLL).
      -->
      <ReferenceCopyLocalPaths Remove="@(_StrideMultiApiFlat)" />
    </ItemGroup>

  </Target>

  <!--
    Copy each API variant into its subdirectory.
  -->
  <Target Name="_StrideMultiApiStage"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <Copy SourceFiles="@(_StrideMultiApiStaged)"
          DestinationFiles="@(_StrideMultiApiStaged->'$(OutDir)%(StageSubPath)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <ItemGroup>
      <FileWrites Include="@(_StrideMultiApiStaged->'$(OutDir)%(StageSubPath)')" />
    </ItemGroup>

  </Target>

</Project>
