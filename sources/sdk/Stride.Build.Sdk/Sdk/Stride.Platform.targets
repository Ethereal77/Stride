<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    ================================================================
    Stride.Sdk - Platform-Specific Build Logic (Sdk.Platform.targets)
    ================================================================

    EVALUATION PHASE: Late (AFTER project file)

    This file applies platform-specific compiler defines and build settings.

    ================================================================
  -->

  <!-- ================================================================ -->
  <!-- Platform Defines - Desktop Frameworks -->
  <!-- ================================================================ -->
  <PropertyGroup Condition=" '$(StrideTargetFramework)' == '$(StrideFramework)' Or '$(StrideTargetFramework)' == '$(StrideFrameworkWindows)' ">
    <StridePlatformDefines>STRIDE_PLATFORM_DESKTOP</StridePlatformDefines>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- .NET Runtime Defines -->
  <!-- ================================================================ -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10'))">
    <StrideNETRuntimeDefines>STRIDE_RUNTIME_CORECLR</StrideNETRuntimeDefines>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Apply Defines to DefineConstants -->
  <!-- IMPORTANT: Must come AFTER all StridePlatformDefines are set   -->
  <!-- ================================================================ -->
  <PropertyGroup>
    <DefineConstants Condition="'$(StridePlatformDefines)' != ''">$(StridePlatformDefines);$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(StrideNETRuntimeDefines)' != ''">$(DefineConstants);$(StrideNETRuntimeDefines)</DefineConstants>
    <DefineConstants Condition="'$(StridePackageBuild)' == 'true'">$(DefineConstants);STRIDE_PACKAGE_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- UWP platform support intentionally omitted (UWP is being phased out) -->

</Project>
