<!--
***********************************************************************************************
  Stride.Build.Sdk: Sdk.targets

  Build Logic and Targets
  EVALUATION PHASE: Late (AFTER project file)

  Copyright (C) Stride and its contributors
***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    What you CAN do here:
    - Check user-defined properties from .csproj (visible now!).
    - Compute derived properties based on user values.
    - Conditionally enable features based on user properties.
    - Define build targets and tasks.

    What you should do here:
    - All conditional logic that depends on .csproj properties.
    - Property computation based on user choices.
    - Build customization based on user configuration.

    Rule: User properties from .csproj ARE visible here.
          This is where conditional logic belongs.

    See: docs/build/SDK-GUIDE.md#property-evaluation-order
  -->

  <!-- ================================================================ -->
  <!-- Import supporting targets files                                  -->
  <!-- ================================================================ -->

  <Import Project="Stride.Frameworks.targets" />
  <Import Project="Stride.Platform.targets" />
  <Import Project="Stride.Graphics.targets" />
  <Import Project="Stride.AssemblyProcessor.targets" />
  <Import Project="Stride.CodeAnalysis.targets" />
  <Import Project="Stride.PackageInfo.targets" />

  <!-- ================================================================ -->
  <!-- Per-project Dev / CI Auto-versioning                             -->
  <!-- ================================================================ -->

  <Import Project="$(StrideRoot)sources\targets\Stride.WorktreeVersion.targets"
          Condition="'$(_StrideWorktreeVersionTargetsImported)' != 'true'" />

  <!-- ================================================================ -->
  <!-- Disable ValidateExecutableReferences                             -->
  <!-- ================================================================ -->

  <!-- Stride's graphics API inner build system (_ComputeTargetFrameworkItems override)
       creates multiple inner build entries per TFM — one per graphics API.

       The .NET SDK's ValidateExecutableReferences task calls .Single() on entries
       filtered by TFM, which crashes when multiple graphics-API variants share the same TFM -->

  <PropertyGroup>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Skip compilation of test projects in package builds              -->
  <!-- ================================================================ -->

  <!-- 'Stride.Build.Sdk.Tests' sets StrideCompilerTargetsEnable=false on 'StridePackageBuild' /
       'StrideSkipUnitTests'.

       This disables compilation by pointing LanguageTargets at a no-op so test projects
       don't compile (and don't build AOT) when producing packages.

       MUST run before the Microsoft.NET.Sdk import below: the SDK assigns LanguageTargets
       (Microsoft.CSharp.targets) under a '$(LanguageTargets)' == '' guard, so the override only
       wins if it's already set when that import runs.

       Gated on IsTestProject so the dormant windows-only StrideCompilerTargetsEnable skip
       further down stays unchanged. -->

  <PropertyGroup Condition="'$(StrideCompilerTargetsEnable)' == 'false' And '$(IsTestProject)' == 'true'">
    <LanguageTargets>$(MSBuildThisFileDirectory)Stride.DisableBuild.targets</LanguageTargets>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Import base Microsoft.NET.Sdk targets                            -->
  <!-- ================================================================ -->

  <!-- This gives us all standard .NET SDK functionality -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- ================================================================ -->
  <!-- Graphics API inner build dispatching (multi-API builds)          -->
  <!-- ================================================================ -->

  <!-- This import MUST come after Microsoft.NET.Sdk Sdk.targets because
       it overrides _ComputeTargetFrameworkItems and _WalkEachTargetPerFramework -->

  <Import Project="Stride.GraphicsApi.InnerBuild.targets" />

  <!-- ================================================================ -->
  <!-- Graphics API consumer-side targets (shared with NuGet consumers) -->
  <!-- ================================================================ -->

  <!-- Lives in 'Stride.Graphics/build/' because the same file is packed into
       the Stride.Graphics NuGet's 'build/' and 'buildTransitive/' directories
       for external consumers.

       Importing it here also gives internal Stride builds (which consume
       Silk.NET native packages directly via PackageReference) the same
       per-API native asset trimming -->

  <Import Project="$(StrideRoot)sources/engine/Stride.Graphics/build/Stride.GraphicsApiSpecificPackages.targets" />

  <!-- ================================================================ -->
  <!-- Multi-graphics-API host layout (launch-time API selection)       -->
  <!-- ================================================================ -->

  <!-- Lay API-dependent runtime DLLs into per-API subdirectories so
       the runtime resolver loads the launch-selected one.
       No-op unless StrideMultiGraphicsApiHost=true. -->

  <Import Project="Stride.MultiGraphicsApiHost.targets"
          Condition="'$(StrideMultiGraphicsApiHost)' == 'true'" />

  <!-- ================================================================ -->
  <!-- Native dependency system (.ssdeps)                               -->
  <!-- ================================================================ -->

  <Import Project="Stride.Dependencies.targets" />

  <!-- Asset build manifest
       (engine self-build path; NuGet consumers get it via Stride.Core buildTransitive) -->

  <Import Project="$(StrideRoot)sources\core\Stride.Core\build\Stride.AssetBuildManifest.targets"
          Condition="'$(StrideAssetBuildManifestImported)' == '' And
                     Exists('$(StrideRoot)sources\core\Stride.Core\build\Stride.AssetBuildManifest.targets')" />

  <Import Project="$(StrideRoot)sources\engine\Stride.Engine\buildTransitive\Stride.AssetConstants.targets"
          Condition="'$(StrideAssetConstantsImported)' == '' And
                     Exists('$(StrideRoot)sources\engine\Stride.Engine\buildTransitive\Stride.AssetConstants.targets')" />

  <PropertyGroup>
    <StrideAssetBuildManifestImported>true</StrideAssetBuildManifestImported>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Native build mode configuration (Clang / MSVC selection)         -->
  <!-- ================================================================ -->

  <Import Project="Stride.NativeBuildMode.props" />

  <!-- Native C/C++ compilation (when StrideNativeOutputName is set) -->
  <Import Project="$(StrideRoot)sources\native\Stride.Native.targets"
          Condition="'$(StrideNativeOutputName)' != ''" />

  <!-- LLVM toolchain for Windows hosts; build-time only, never a package dependency -->
  <ItemGroup Condition="'$(StrideNativeOutputName)' != '' And
                        $([MSBuild]::IsOSPlatform('Windows'))">

    <PackageReference Include="Stride.Dependencies.LLVM.Windows" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- Shader Code Generation Support                                   -->
  <!-- ================================================================ -->

  <!-- Auto-discover .SDSL / .SDFX files:
        * Register them as AdditionalFiles for the Roslyn source generator.
        * Mark generated .cs as dependent.
        * Tag the files with the VS Custom Tool generator for older projects that still use it.

       Projects that contain .SDSL / .SDFX files as test inputs or other non-shader content
       can set EnableDefaultStrideShaderItems=false to opt out -->

  <PropertyGroup>
    <EnableDefaultStrideShaderItems Condition="'$(EnableDefaultStrideShaderItems)' == ''">true</EnableDefaultStrideShaderItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultStrideShaderItems)' == 'true'">

    <StrideShaderFiles Include="**\*.sdsl" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="**\*.sdsl" />

    <StrideShaderFiles Include="**\*.sdfx" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="**\*.sdfx" />

    <AdditionalFiles Include="@(StrideShaderFiles)" />

    <ProjectReference Condition="'@(StrideShaderFiles)' != ''"
                      Include="$(StrideRoot)sources\shaders\Stride.Shaders.Generators\Stride.Shaders.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Shaders are the project-source assets the asset compiler builds;
       declare their extensions for the .sdbuild manifest here, next to where the files are globbed -->
  <PropertyGroup>
    <StrideProjectAssetExtensions>$(StrideProjectAssetExtensions);.sdsl;.sdfx</StrideProjectAssetExtensions>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Stride.Core.CompilerServices Roslyn Analyzer                     -->
  <!-- ================================================================ -->

  <!-- Stride.Core.CompilerServices is single-TFM (netstandard2.0),
       so an explicit SetTargetFramework is redundant and harmful:
       it forces TargetFramework into the consumer-ref dispatch globals,
       producing a cache key distinct from the slnf-direct outer dispatch
       (which has no TFM global). Both then race on obj/ -->

  <ItemGroup Condition="!$(MSBuildProjectName.StartsWith('Stride.Core.CompilerServices'))">

    <ProjectReference Include="$(StrideRoot)sources\core\Stride.Core.CompilerServices\Stride.Core.CompilerServices.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- Stride Assets URL Roslyn Source Generator                        -->
  <!-- ================================================================ -->

  <!-- Asset URL constants generator, only where its inputs exist
       (an authored .sdpkg next to the project);
       consumers get it from the Stride.Engine package instead -->

  <ItemGroup Condition="'$(StrideGenerateAssetConstants)' != 'false' And
                        Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).sdpkg')">

    <ProjectReference Include="$(StrideRoot)sources\engine\Stride.Assets.Generators\Stride.Assets.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- StridePublicApi - User Documentation (.usrdoc) Support           -->
  <!-- ================================================================ -->

  <PropertyGroup Condition="'$(StridePublicApi)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.usrdoc</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_StrideRegisterUserDocOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="_StrideRegisterUserDocOutputs">
    <ItemGroup Condition="Exists('$(OutputPath)$(AssemblyName).usrdoc')">
      <BuildOutputInPackage Include="$(OutputPath)$(AssemblyName).usrdoc"/>
    </ItemGroup>
  </Target>

  <Target Name="_StrideRegisterUserDocReferenceRelatedFileExtensions"
          Condition="'$(StridePublicApi)' == 'true'"
          BeforeTargets="ResolveAssemblyReferences">

    <PropertyGroup>
      <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.usrdoc</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

  </Target>

  <!-- ================================================================ -->
  <!-- StrideScript - Auto-enable Assembly Processor for scripts        -->
  <!-- ================================================================ -->

  <PropertyGroup>
    <StrideAssemblyProcessor Condition="'$(StrideScript)' == 'true'">true</StrideAssemblyProcessor>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- SourceLink - GitHub Source Debugging                             -->
  <!-- ================================================================ -->

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub"
                      Condition="'$(StrideProjectType)' == 'CSharp' And '$(SkipSourceLink)' != 'true'"
                      PrivateAssets="All" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- StrideCompilerTargetsEnable - Conditional Build Skip             -->
  <!-- ================================================================ -->

  <PropertyGroup>
    <StrideCompilerTargetsEnable
        Condition="'$(StrideTargetFramework)' != '$(StrideFramework)' And
                   '$(StrideTargetFramework)' == '$(StrideFrameworkWindows)' And
                   '$(StrideWindowsOnly)' == 'true'">false</StrideCompilerTargetsEnable>

    <!-- Skip unit tests if requested -->
    <StrideCompilerTargetsEnable
        Condition="'$(StrideSkipUnitTests)' == 'true' And
                   $(StrideOutputFolder.StartsWith('Tests'))">false</StrideCompilerTargetsEnable>

    <!-- If StrideCompilerTargetsEnable is set to false, override LanguageTargets to an empty one -->
    <LanguageTargets Condition="'$(StrideCompilerTargetsEnable)' == 'false'">$(MSBuildThisFileDirectory)Stride.DisableBuild.targets</LanguageTargets>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Asset Packing Support (StridePackAssets)                         -->
  <!-- ================================================================ -->

  <!-- When StridePackAssets=true, use 'Stride.Core.Tasks' to copy .sdpkg, assets and templates
       into the NuGet package.
       This is a lightweight operation that doesn't need CompilerApp -->

  <Target Name="_StridePrepareAssetsForPack"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(StridePackAssets)' == 'true' Or '$(StrideContainsAssetTypes)' == 'true'">

    <!-- Host-loadable assembly whose types appear in assets:
           written into the packed .sdpkg's AssetAssemblies so the asset compiler loads exactly it
           (relative to lib/<host-tfm>/) -->

    <PropertyGroup>
      <_StridePackAssetAssembliesArg Condition="'$(StrideContainsAssetTypes)' == 'true'"> --pack-asset-assembly=&quot;lib/$(StrideFramework)/$(AssemblyName).dll&quot;</_StridePackAssetAssembliesArg>
    </PropertyGroup>

    <Exec Command="dotnet &quot;$(StrideRoot)sources/core/Stride.Core.Tasks/bin/$(Configuration)/$(StrideFramework)/Stride.Core.Tasks.dll&quot; pack-assets &quot;$(MSBuildProjectFile)&quot; &quot;$(IntermediateOutputPath)stride&quot;$(_StridePackAssetAssembliesArg)"
          ConsoleToMsBuild="true">

      <Output TaskParameter="ConsoleOutput" ItemName="PackAssetsLine" />
    </Exec>

    <ItemGroup>
      <PackAssetsLine Update="@(PackAssetsLine)">
        <SourcePath>$([System.String]::new('%(Identity)').Split('|')[0])</SourcePath>
        <PackagePath>$([System.String]::new('%(Identity)').Split('|')[1])</PackagePath>
      </PackAssetsLine>
      <None Include="%(PackAssetsLine.SourcePath)">
        <Pack>true</Pack>
        <PackagePath>%(PackAssetsLine.PackagePath)</PackagePath>
      </None>
    </ItemGroup>

  </Target>

  <!-- ================================================================ -->
  <!-- FastUpToDateCheck                                                -->
  <!-- ================================================================ -->

  <!-- Invalidate when packed content files change:
         VS's FastUpToDateCheck only watches Compile items by default.

         Pack-only content (build / buildTransitive targets, AssetPackage assets, etc.)
         is declared via None / Content with Pack="true";
         if those change and nothing in Compile does, VS reports "up to date" and
         skips Build / Pack so the .nupkg never refreshes.

         Registering them as UpToDateCheckInput forces a rebuild whenever they're edited. -->

  <ItemGroup>
    <UpToDateCheckInput Include="@(None->WithMetadataValue('Pack', 'true'))" />
    <UpToDateCheckInput Include="@(Content->WithMetadataValue('Pack', 'true'))" />
  </ItemGroup>

  <!-- Bump the copy marker when our own assembly rebuilds:
         The copy-up-to-date marker is only touched by _CopyFilesMarkedCopyLocal,
         which copies changed copy-local deps (not when this project's own assembly
         recompiles with an unchanged public API — routine after the Assembly Processor:
         same ref Assembly, new implementation.

         So a body-only change leaves the marker stale and consumers' FastUpToDateCheck
         never re-copies the refreshed Assembly (dotnet/msbuild#13478).

         Touch it after a real CoreCompile so the marker reflects the rebuild -->

  <Target Name="_StrideTouchCopyMarkerAfterCompile"
          AfterTargets="CoreCompile"
          Condition="'@(CopyUpToDateMarker)' != '' And
                     '$(DesignTimeBuild)' != 'true' And
                     '$(SkipCompilerExecution)' != 'true'">

    <Touch Files="@(CopyUpToDateMarker)" AlwaysCreate="true">
      <Output TaskParameter="TouchedFiles" ItemName="FileWrites" />
    </Touch>

  </Target>

  <!-- ================================================================ -->
  <!-- Auto-Pack and Deploy for NuGet Development                       -->
  <!-- ================================================================ -->

  <!-- Dev packages mode:
         Skip packing and use redirect packages (must set StrideSkipAutoPack
         before Stride.AutoPackDeploy.targets evaluates its GeneratePackageOnBuild gate) -->

  <Import Project="$(StrideRoot)sources\targets\Stride.DevPackages.targets" />
  <Import Project="$(StrideRoot)sources\targets\Stride.AutoPackDeploy.targets" />

  <!-- ================================================================ -->
  <!-- Swap SharedAssemblyInfo.cs -> SharedAssemblyInfo.Generated.cs    -->
  <!-- ================================================================ -->

  <!-- The single place that swaps the version template for the generated overlay,
       so the StrideVersion.* consts carry the real computed version.

       * Dev/CI builds: StrideEnsureWorktreeVersion (a dependency) generates the overlay first.

       * Package builds: The overlay is generated once up front by StrideGitVersion in Stride.build,
         so here we only require that it exists. If it is somehow missing we leave the base template,
         which compiles the sentinel PublicVersion (4.4.65534) - loud rather than a plausible-looking
         wrong version. -->

  <Target Name="StrideApplyGeneratedVersion"
          DependsOnTargets="StrideEnsureWorktreeVersion"
          BeforeTargets="PrepareResources">

    <Error Condition="'$(StridePackageBuild)' == 'true' And !Exists('$(StrideRoot)sources\shared\SharedAssemblyInfo.Generated.cs')"
           Text="SharedAssemblyInfo.Generated.cs has not been generated. Make sure the Stride.build PackageEnvironment target (StrideGitVersion) ran successfully before the package build."/>

    <ItemGroup Condition="Exists('$(StrideRoot)sources\shared\SharedAssemblyInfo.Generated.cs')">

      <StrideSharedAssemblyFile Include="@(Compile)"
                                Condition="'%(Compile.FullPath)' == '$([System.IO.Path]::GetFullPath(`$(StrideRoot)sources\shared\SharedAssemblyInfo.cs`))'"/>

      <Compile Remove="@(StrideSharedAssemblyFile)" />
      <Compile Include="@(StrideSharedAssemblyFile->'$(StrideRoot)sources\shared\SharedAssemblyInfo.Generated.cs')" />

    </ItemGroup>

  </Target>

  <!-- ====================================================================== -->
  <!-- Cascade Pack to ProjectReferences (re-dispatch at outer for Auto-Pack) -->
  <!-- ====================================================================== -->

  <!-- Natural ProjectReference dispatch goes to inner (TFM set via NuGet's nearest-TFM probe);

       _PackAsBuildAfterTarget is gated on "IsInnerBuild != true" so refs never auto-pack via that path.
        Re-dispatch at outer (TFM stripped) so the cross-targeting outer Build's AfterTargets Pack fires -->

  <Target Name="_StrideTriggerPackOnInnerBuild"
          BeforeTargets="CoreCompile"
          Condition="'$(BuildingInsideVisualStudio)' != 'true' And '$(GeneratePackageOnBuild)' == 'true'">

    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Condition="'%(_MSBuildProjectReferenceExistent.SetTargetFramework)' != ''"
             BuildInParallel="$(BuildInParallel)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);TargetFramework;StrideGraphicsApi$(_GlobalPropertiesToRemoveFromProjectReferences)" />

  </Target>

  <!-- ================================================================ -->
  <!-- Stride.Local.props Bootstrap (in-source only)                    -->
  <!-- ================================================================ -->

  <!-- Parallel project builds all fire this target concurrently;
       a plain <Copy> here races with sibling projects re-evaluating the <Import>
       in Stride.Platform.props (MSB4024: "file is being used by another process").

       _StrideAtomicCopyIfMissing writes to a unique temp file then File.Moves it into place
       (atomic via MoveFileEx on NTFS).
       Losers of the race clean up their temp -->

  <UsingTask TaskName="_StrideAtomicCopyIfMissing"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <DidCreate ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>

    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        DidCreate = false;
        if (System.IO.File.Exists(DestinationFile))
            return true;

        var tmp = DestinationFile + "." + System.Guid.NewGuid().ToString("N") + ".tmp";

        try
        {
            System.IO.File.Copy(SourceFile, tmp);

            // File.Move(src, dst) throws IOException when dst already exists — the race-loser arm
            System.IO.File.Move(tmp, DestinationFile);
            DidCreate = true;
        }
        catch (System.IO.IOException)
        {
            // Another parallel build won; clean up our temp
            try
            {
                System.IO.File.Delete(tmp);
            }
            catch { /* Ignore errors while deleting */ }
        }
        return true;
        ]]>
      </Code>
    </Task>

  </UsingTask>

  <!-- Copies 'Stride.Local.props.template' to the repo root directory on first Restore / Build.

       _StrideLocalProps and _StrideLocalPropsTemplate are populated in 'Stride.Platform.props';
       both are empty for end-users consuming the SDK from NuGet (no 'global.json' anchor),
       so this no-ops.

       Runs before Restore and Build to cover the 'dotnet build', 'dotnet restore', and
       no-restore flows.
       Imports happen during evaluation, so the just-written file is picked up on the next invocation,
       not the current one (first build uses defaults) -->

  <Target Name="_StrideBootstrapLocalProps"
          BeforeTargets="Restore;Build"
          Condition="'$(_StrideLocalProps)' != '' And
                     !Exists('$(_StrideLocalProps)') And
                     Exists('$(_StrideLocalPropsTemplate)')">

    <_StrideAtomicCopyIfMissing
        SourceFile="$(_StrideLocalPropsTemplate)" DestinationFile="$(_StrideLocalProps)">

      <Output TaskParameter="DidCreate" PropertyName="_StrideLocalPropsCreated" />

    </_StrideAtomicCopyIfMissing>

    <Message Importance="High"
             Condition="'$(_StrideLocalPropsCreated)' == 'true'"
             Text="Created $(_StrideLocalProps) from template — edit it to customize local build settings." />

  </Target>

  <!-- =================================================================== -->
  <!-- Strip unused ComInterfaceGenerator (slow, we don't use the feature) -->
  <!-- =================================================================== -->

  <Target Name="_StrideStripComInterfaceGenerator"
          BeforeTargets="CoreCompile">

    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.Interop.ComInterfaceGenerator'" />
    </ItemGroup>

  </Target>

  <!-- ================================================================ -->
  <!-- Configuration Validation -->
  <!-- ================================================================ -->

  <Target Name="_StrideValidateConfiguration" BeforeTargets="Build">

    <Error Condition="'$(StrideGraphicsApiDependent)' == 'true' And '$(StrideGraphicsApi)' == ''"
           Text="StrideGraphicsApi must be set when StrideGraphicsApiDependent is true. Set a default in your project or use Stride.Graphics.props." />

    <Error Condition="'$(StrideAssemblyProcessor)' == 'true' And '$(StrideAssemblyProcessorPath)' != '' And !Exists('$(StrideAssemblyProcessorPath)')"
           Text="StrideAssemblyProcessorPath '$(StrideAssemblyProcessorPath)' does not exist. Rebuild the Assembly Processor or check the path." />

    <Warning Condition="'$(StridePlatform)' == ''"
             Text="StridePlatform is not set. Platform-specific features may not work correctly. Check Stride.Platform.props." />
  </Target>

</Project>
