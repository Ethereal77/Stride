<Project>

  <!--
    Static (non-version) NuGet metadata shared by every packable Stride project.
    Imported by the Stride.Build.Sdk (Stride.PackageInfo.targets)
    and by standalone packages such as Stride.Cli.
  -->
  <PropertyGroup>
    <Product>Stride Game Engine</Product>
    <ProductName>Stride Game Engine</ProductName>

    <PackageProjectUrl>https://stride3d.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ethereal77/stride</RepositoryUrl>

    <Authors>Stride contributors</Authors>
    <Copyright>Copyright © Stride contributors</Copyright>

    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageTags>Stride;3D;gamedev;Game Engine;engine;games;D3D</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)nuget-icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
