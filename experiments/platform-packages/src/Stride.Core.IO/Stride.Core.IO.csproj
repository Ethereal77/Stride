<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <PackageId>Stride.Core.IO</PackageId>
    <RootNamespace>Stride.Core.IO</RootNamespace>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>I/O meta-package that selects the platform-specific Stride.Core.IO implementation (experiment).</Description>

    <!-- This project references every axis package on purpose; consumer checks do not apply. -->
    <StridePlatformSkipAxisValidation>true</StridePlatformSkipAxisValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(StridePlatformPacking)' != 'true'">
    <ProjectReference Include="..\Stride.Platform\Stride.Platform.csproj" />
    <ProjectReference Include="..\Stride.Core.IO.Common\Stride.Core.IO.Common.csproj" />
    <ProjectReference Include="..\Stride.Core.IO.Windows\Stride.Core.IO.Windows.csproj" />
    <ProjectReference Include="..\Stride.Core.IO.Linux\Stride.Core.IO.Linux.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(StridePlatformPacking)' == 'true'">
    <PackageReference Include="Stride.Platform" Version="$(PackageVersion)" PrivateAssets="none" />
    <PackageReference Include="Stride.Core.IO.Common" Version="$(PackageVersion)" PrivateAssets="none" />
    <PackageReference Include="Stride.Core.IO.Windows" Version="$(PackageVersion)" PrivateAssets="none" />
    <PackageReference Include="Stride.Core.IO.Linux" Version="$(PackageVersion)" PrivateAssets="none"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\net10.0\_._" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="lib\net10.0-windows7.0\_._" Pack="true" PackagePath="lib\net10.0-windows7.0\" />
  </ItemGroup>
</Project>
