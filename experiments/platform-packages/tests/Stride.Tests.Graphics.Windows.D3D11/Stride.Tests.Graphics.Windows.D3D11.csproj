<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- One API per test binary: the meta-package prunes the other variants. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <StrideGraphicsApi>Direct3D11</StrideGraphicsApi>
    <AssemblyName>Stride.Tests.Graphics.Windows.D3D11</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Graphics" Version="$(StridePlatformVersion)" />
  </ItemGroup>
</Project>
