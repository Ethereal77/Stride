<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- One project, two TFMs: portable on net10.0, Windows on net10.0-windows. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <AssemblyName>MultiTargetProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Platform" Version="$(StridePlatformVersion)" />
  </ItemGroup>
</Project>
