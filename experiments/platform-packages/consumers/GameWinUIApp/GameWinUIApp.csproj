<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>GameWinUIApp</AssemblyName>
    <!-- Explicit windowing choice: WinUI is not the Windows default. -->
    <StrideWindowSystem>WinUI</StrideWindowSystem>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Games" Version="$(StridePlatformVersion)" />
    <PackageReference Include="Stride.Graphics" Version="$(StridePlatformVersion)" />
  </ItemGroup>
</Project>
