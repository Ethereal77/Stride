<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Linux has no TFM; an executable must state the platform. -->
    <StridePlatform>Linux</StridePlatform>
    <StrideWindowSystem>X11</StrideWindowSystem>
    <StrideGraphicsApi>Vulkan</StrideGraphicsApi>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <AssemblyName>GameLinuxApp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Games" Version="$(StridePlatformVersion)" />
    <PackageReference Include="Stride.Graphics" Version="$(StridePlatformVersion)" />
    <PackageReference Include="Stride.Core.IO" Version="$(StridePlatformVersion)" />
  </ItemGroup>
</Project>
