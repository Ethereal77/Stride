<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Fully local feed for the experiment. Package source mapping keeps the
    prototype's packages away from nuget.org (which hosts real Stride packages
    with the same IDs).
  -->
  <packageSources>
    <clear />
    <add key="platform-local" value="artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="platform-local">
      <package pattern="Stride.Platform" />
      <package pattern="Stride.Platform.*" />
      <package pattern="Stride.Core.IO" />
      <package pattern="Stride.Core.IO.*" />
      <package pattern="Stride.Graphics" />
      <package pattern="Stride.Graphics.*" />
      <package pattern="Stride.AppModel" />
      <package pattern="Stride.Games" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
