<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Stride.Graphics.Direct3D12</AssemblyName>
    <RootNamespace>Stride.Graphics.Direct3D12</RootNamespace>
    <PackageId>Stride.Graphics.Direct3D12</PackageId>
    <Description>Direct3D 12 variant of the Stride.Graphics meta-package (experiment).</Description>

    <!-- Compile-time constants of this variant; see Stride.Graphics.Direct3D11.csproj. -->
    <DefineConstants>$(DefineConstants);STRIDE_GRAPHICS_API_DIRECT3D12;STRIDE_PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Graphics.Common\Stride.Graphics.Common.csproj" />
    <ProjectReference Include="..\Stride.MetaExperiment.Native.Direct3D12\Stride.MetaExperiment.Native.Direct3D12.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\*.targets" Pack="true" PackagePath="build\" />
    <None Include="build\*.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
