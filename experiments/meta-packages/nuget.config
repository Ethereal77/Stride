<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Fully local feed for the experiment. The package source mapping keeps the
    prototype's Stride.Graphics* packages away from nuget.org (which also hosts
    real Stride packages with the same IDs).
  -->
  <packageSources>
    <clear />
    <add key="meta-local" value="artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="meta-local">
      <package pattern="Stride.Graphics" />
      <package pattern="Stride.Graphics.*" />
      <package pattern="Stride.MetaExperiment.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
